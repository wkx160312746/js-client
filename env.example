# Ratel 客户端环境变量配置
# Zeabur 推荐只设置 RATEL_WS_URL，其他变量可选。

# 后端公开 WebSocket 地址。Zeabur 域名使用 wss，路径为 /ws。
RATEL_WS_URL=wss://your-server.zeabur.app/ws

# 前端监听端口。Zeabur 会自动注入，一般无需手工设置。
PORT=8080

# 服务器主机名或IP地址
RATEL_SERVER_HOST=ratel-be.youdomain.com

# 服务器端口号
RATEL_SERVER_PORT=443

# 服务器名称
RATEL_SERVER_NAME=Nico

# 服务器版本
RATEL_SERVER_VERSION=v1.3.0

# 是否为开发环境
RATEL_IS_DEVELOPMENT=false

# 未设置 RATEL_WS_URL 时，用这些分项变量拼接 WebSocket 地址。
BACKEND_USE=wss

# 使用示例：
# 开发环境配置
# RATEL_SERVER_HOST=localhost
# RATEL_SERVER_PORT=1025
# RATEL_IS_DEVELOPMENT=true

# 生产环境配置
# RATEL_SERVER_HOST=game.example.com
# RATEL_SERVER_PORT=80
# RATEL_IS_DEVELOPMENT=false
